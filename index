<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Plast-ecc / html — навигация</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0d1117;
      color: #e6edf3;
      min-height: 100vh;
      padding: 2rem 1rem;
    }
    .container {
      max-width: 900px;
      margin: 0 auto;
    }
    .header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #30363d;
    }
    .header .repo-icon {
      font-size: 1.8rem;
    }
    .header h1 {
      font-size: 1.4rem;
      font-weight: 600;
    }
    .header h1 span { color: #8b949e; font-weight: 400; }
    .header .badge {
      background: #21262d;
      border: 1px solid #30363d;
      color: #8b949e;
      font-size: 0.75rem;
      padding: 0.15rem 0.6rem;
      border-radius: 20px;
      margin-left: 0.5rem;
    }

    .file-list {
      list-style: none;
      border: 1px solid #30363d;
      border-radius: 10px;
      overflow: hidden;
      background: #161b22;
    }
    .file-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.85rem 1rem;
      border-bottom: 1px solid #21262d;
      cursor: pointer;
      transition: background 0.15s;
      text-decoration: none;
      color: inherit;
    }
    .file-item:last-child { border-bottom: none; }
    .file-item:hover {
      background: #1f242c;
    }
    .file-item .icon {
      font-size: 1.1rem;
      width: 24px;
      text-align: center;
    }
    .file-item .name {
      flex: 1;
      font-weight: 500;
      font-size: 0.95rem;
    }
    .file-item .meta {
      font-size: 0.8rem;
      color: #8b949e;
    }
    .file-item .open-arrow {
      color: #58a6ff;
      font-size: 0.9rem;
      opacity: 0;
      transition: opacity 0.15s;
    }
    .file-item:hover .open-arrow {
      opacity: 1;
    }

    .loading, .error {
      padding: 2rem;
      text-align: center;
      color: #8b949e;
      border: 1px solid #30363d;
      border-radius: 10px;
      background: #161b22;
    }
    .error { color: #f85149; border-color: #f85149; }

    .footer {
      margin-top: 1.5rem;
      text-align: center;
      color: #484f58;
      font-size: 0.8rem;
    }
    .footer a {
      color: #58a6ff;
      text-decoration: none;
    }
    .footer a:hover { text-decoration: underline; }

    /* Просмотр файла */
    .viewer {
      margin-top: 1.5rem;
      border: 1px solid #30363d;
      border-radius: 10px;
      overflow: hidden;
      background: #0d1117;
      display: none;
    }
    .viewer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.7rem 1rem;
      background: #161b22;
      border-bottom: 1px solid #30363d;
      font-size: 0.9rem;
    }
    .viewer-header .file-name {
      font-weight: 600;
      color: #58a6ff;
    }
    .viewer-header button {
      background: #21262d;
      border: 1px solid #30363d;
      color: #c9d1d9;
      padding: 0.3rem 0.8rem;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.8rem;
      transition: background 0.15s;
    }
    .viewer-header button:hover {
      background: #30363d;
    }
    .viewer iframe {
      width: 100%;
      height: 70vh;
      border: none;
      background: white;
      display: block;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="repo-icon">📁</div>
      <h1>
        Plast-ecc <span>/</span> html
        <span class="badge">Public</span>
      </h1>
    </div>

    <div id="fileListContainer">
      <div class="loading">⏳ Загрузка списка файлов...</div>
    </div>

    <div class="viewer" id="viewer">
      <div class="viewer-header">
        <span class="file-name" id="viewerFileName">—</span>
        <button onclick="closeViewer()">✕ Закрыть</button>
      </div>
      <iframe id="viewerFrame" src="about:blank"></iframe>
    </div>

    <div class="footer">
      Источник: <a href="https://github.com/Plast-ecc/html" target="_blank">github.com/Plast-ecc/html</a>
    </div>
  </div>

  <script>
    const REPO_OWNER = 'Plast-ecc';
    const REPO_NAME = 'html';
    const BRANCH = 'main';

    async function loadFiles() {
      const container = document.getElementById('fileListContainer');
      try {
        const res = await fetch(
          `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/?ref=${BRANCH}`
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const files = await res.json();

        // Оставляем только файлы (не папки), сортируем по имени
        const onlyFiles = files
          .filter(f => f.type === 'file')
          .sort((a, b) => a.name.localeCompare(b.name));

        if (onlyFiles.length === 0) {
          container.innerHTML = '<div class="loading">Файлы не найдены</div>';
          return;
        }

        const ul = document.createElement('ul');
        ul.className = 'file-list';

        onlyFiles.forEach(file => {
          const li = document.createElement('li');
          const icon = getFileIcon(file.name);
          const size = file.size ? formatSize(file.size) : '';

          li.innerHTML = `
            <div class="file-item" data-file="${file.name}" data-url="${file.download_url || ''}">
              <span class="icon">${icon}</span>
              <span class="name">${file.name}</span>
              <span class="meta">${size}</span>
              <span class="open-arrow">→</span>
            </div>
          `;

          li.querySelector('.file-item').addEventListener('click', () => {
            openFile(file.name, file.download_url);
          });

          ul.appendChild(li);
        });

        container.innerHTML = '';
        container.appendChild(ul);
      } catch (err) {
        container.innerHTML = `
          <div class="error">
            ❌ Не удалось загрузить список файлов.<br>
            <small>${err.message}</small><br><br>
            <small>Возможно, превышен лимит GitHub API. Попробуйте позже.</small>
          </div>
        `;
      }
    }

    function getFileIcon(name) {
      if (name.endsWith('.html')) return '🌐';
      if (name.endsWith('.css'))  return '🎨';
      if (name.endsWith('.js'))   return '⚡';
      if (name.endsWith('.json')) return '📦';
      if (name.endsWith('.md'))   return '📝';
      if (name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.svg')) return '🖼️';
      return '📄';
    }

    function formatSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function openFile(name, rawUrl) {
      if (!rawUrl) {
        alert('Ссылка на файл недоступна');
        return;
      }
      const viewer = document.getElementById('viewer');
      const frame = document.getElementById('viewerFrame');
      const title = document.getElementById('viewerFileName');

      title.textContent = name;
      // Используем htmlpreview для рендеринга HTML прямо с GitHub
      frame.src = `https://htmlpreview.github.io/?${rawUrl}`;
      viewer.style.display = 'block';
      viewer.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function closeViewer() {
      const viewer = document.getElementById('viewer');
      const frame = document.getElementById('viewerFrame');
      frame.src = 'about:blank';
      viewer.style.display = 'none';
    }

    loadFiles();
  </script>
</body>
</html>
